{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/udibott-011235/pyMagicStats/knowledge/schema/registry.schema.json",
  "title": "pyMagicStats knowledge registry",
  "type": "object",
  "required": ["schema_version", "knowledge_base_version", "repository", "canonical_branch", "roles", "records"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "knowledge_base_version": {"const": "1.3.0"},
    "last_updated": {"type": "string", "format": "date"},
    "repository": {"const": "udibott-011235/pyMagicStats"},
    "canonical_branch": {"const": "main"},
    "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "status", "scope", "path", "evidence_paths", "owner_role", "reviewer_roles", "supersedes", "tags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
          "kind": {"enum": ["theory", "paper", "dataset", "experiment", "evidence", "decision", "debt", "role-note", "branch"]},
          "status": {"enum": ["proposed", "under_review", "accepted", "validated_with_limits", "open", "blocked", "rejected", "superseded", "archived"]},
          "title": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "evidence_paths": {"type": "array", "items": {"type": "string"}},
          "owner_role": {"type": "string"},
          "reviewer_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "supersedes": {"type": "array", "items": {"type": "string"}},
          "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "branch": {
            "type": "object",
            "required": [
              "name",
              "head_sha_at_decision",
              "observed_at",
              "relation_to_main",
              "integration_state",
              "ahead_of_main",
              "behind_main",
              "unique_commits",
              "decision_reason"
            ],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "head_sha_at_decision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
              "observed_at": {"type": "string", "format": "date"},
              "relation_to_main": {
                "enum": ["canonical", "same_head", "fully_contained", "contains_main", "diverged"]
              },
              "integration_state": {
                "enum": ["not_applicable", "pending", "merge_candidate", "merged", "not_planned"]
              },
              "ahead_of_main": {"type": "integer", "minimum": 0},
              "behind_main": {"type": "integer", "minimum": 0},
              "unique_commits": {
                "type": "array",
                "items": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
                "uniqueItems": true
              },
              "decision_reason": {"type": "string", "minLength": 1},
              "merge_base": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
              "merged_via": {"type": "string", "minLength": 1},
              "pr_number": {"type": "integer", "minimum": 1},
              "parent_branch": {"type": "string", "minLength": 1},
              "parent_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
              "next_action": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"kind": {"const": "branch"}},
              "required": ["kind"]
            },
            "then": {"required": ["branch"]},
            "else": {"not": {"required": ["branch"]}}
          }
        ],
        "additionalProperties": false
      }
    }
  }
}

